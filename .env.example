# ─────────────────────────────────────────────────────────────────
# Variáveis de ambiente — copie este arquivo para .env e preencha
# os valores reais. O arquivo .env NUNCA deve ser commitado.
# ─────────────────────────────────────────────────────────────────

# Google Maps API Key
# Obtenha em: https://console.cloud.google.com/apis/credentials
# APIs que precisam estar habilitadas nessa chave:
#   - Maps JavaScript API
#   - Places API (New)
#   - Geocoding API
VITE_GOOGLE_MAPS_API_KEY=sua_chave_aqui
